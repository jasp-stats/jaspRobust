msgstr "Fout tijdens het laden van gegevens: %s"

msgid ""
"Robust repeated measures ANOVA currently supports only one within-subjects"
"factor."
msgstr ""
"Robuuste ANOVA voor herhaalde metingen ondersteunt momenteel slechts één "
"binnen-proefpersoonfactor."

msgid ""
"Robust repeated measures ANOVA currently supports at most one between-subjects"
"factor."
msgstr ""
"Robuuste ANOVA voor herhaalde metingen ondersteunt momenteel maximaal één "
"tussen-proefpersoonfactor."

msgid ""
"Median-based robust analysis is not currently supported for repeated measures"
"designs. Please select Trimmed Means or Trimmed Means + Bootstrap."
msgstr ""
"Op medianen gebaseerde robuuste analyse wordt momenteel niet ondersteund voor "
"ontwerpen met herhaalde metingen. Selecteer Getrimde gemiddelden of Getrimde "
"gemiddelden + Bootstrap."

msgid "Bootstrap mixed RM ANOVA failed:\\n%s"
msgstr "Bootstrap-gemengde ANOVA voor herhaalde metingen mislukt:\\n%s"

msgid "Mixed RM ANOVA failed: %s"
msgstr "Gemengde ANOVA voor herhaalde metingen is mislukt: %s"

