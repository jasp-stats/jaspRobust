msgstr "Gruppe 1: %1$s; Gruppe 2: %2$s"

msgid "Bootstrap ANCOVA with trimmed means (%.0f%% trimming, %d bootstrap samples)."
msgstr ""
"Bootstrap-ANCOVA mit getrimmten Mittelwerten (%.0f%%-Trimmen, %d Bootstrap-"
"Stichproben)."

msgid "Trimmed means compared using %.0f%% trimming."
msgstr "Getrimmte Mittelwerte verglichen mit %.0f%%-Trimmen."

msgid ""
"Wilcox, R. (2012). Introduction to Robust Estimation and Hypothesis Testing"
"(3rd ed.). Elsevier."
msgstr ""
"Wilcox, R. (2012). Introduction to Robust Estimation and Hypothesis Testing "
"(3rd ed.). Elsevier."

