msgstr "ANOVA univariée hétéroscédastique pour moyennes tronquées (troncature de %.0f%%)."

msgid "\\u03BE denotes the explanatory measure of effect size."
msgstr "\\u03BE désigne la mesure explicative de la taille d'effet."

msgid ""
"Percentile t-bootstrap one-way ANOVA for trimmed means (%.0f%% trimming, %d"
"bootstrap samples)."
msgstr ""
"ANOVA univariée t-bootstrap en percentiles pour moyennes tronquées (troncature"
"de %.0f%%, %d échantillons bootstrap)."

msgid "Heteroscedastic one-way ANOVA for medians."
msgstr "ANOVA univariée hétéroscédastique pour les médianes."

