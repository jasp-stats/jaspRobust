msgstr "效应"

msgid "Critical Value"
msgstr "临界值"

msgid "Heteroscedastic one-way ANOVA for trimmed means (%.0f%% trimming)."
msgstr "修剪均值的异方差单因素方差分析（%.0f%% 修剪）。"

msgid "ξ denotes the explanatory measure of effect size."
msgstr "ξ 表示解释性效应量。"

msgid "Percentile t-bootstrap one-way ANOVA for trimmed means (%.0f%% trimming, %d bootstrap samples)."
msgstr ""
"修剪均值的百分位 t-Bootstrap 单因素方差分析（%.0f%% 修剪，%d 个 Bootstrap 样"
"本）。"

msgid "Heteroscedastic one-way ANOVA for medians."
msgstr "中位数的异方差单因素方差分析。"

msgid "Two-way ANOVA for trimmed means (%.0f%% trimming)."
msgstr "修剪均值的双因素方差分析（%.0f%% 修剪）。"

msgid "Two-way ANOVA for medians."
msgstr "中位数的双因素方差分析。"

msgid "Three-way ANOVA for trimmed means (%.0f%% trimming)."
msgstr "修剪均值的三因素方差分析（%.0f%% 修剪）。"

msgid "Post Hoc Tests"
msgstr "事后检验"

