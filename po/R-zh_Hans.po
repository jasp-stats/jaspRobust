msgid "Robust ANCOVA requires a factor with exactly 2 levels, but '%1$s' has %2$d levels."
msgstr "稳健协方差分析要求因子恰好有 2 个水平，但“%1$s”有 %2$d 个水平。"

msgid "Robust ANCOVA failed: %s"
msgstr "稳健协方差分析失败：%s"

msgid "Robust ANOVA with trimmed means supports at most 3 factors."
msgstr "使用修剪均值的稳健方差分析最多支持 3 个因子。"

msgid "Bootstrap robust ANOVA is currently only supported for one-way designs."
msgstr "Bootstrap 稳健方差分析目前仅支持单因素设计。"

msgid "Robust ANOVA with medians supports at most 2 factors."
msgstr "使用中位数的稳健方差分析最多支持 2 个因子。"

msgid "Robust ANOVA failed: %s"
msgstr "稳健方差分析失败：%s"

msgid "Robust ANCOVA"
msgstr "稳健协方差分析"

