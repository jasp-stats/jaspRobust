#, qt-format
msgid ""
"Robust ANCOVA requires a factor with exactly 2 levels, but '%1$s' has %2$d"
"levels."
msgstr ""
"L'ANCOVA robuste nécessite un facteur avec exactement 2 niveaux, mais « %1$s »"
"en compte %2$d."

msgid "Robust ANCOVA failed: %s"
msgstr "Échec de l'ANCOVA robuste : %s"

msgid "Robust ANOVA with trimmed means supports at most 3 factors."
msgstr "L'ANOVA robuste avec moyennes tronquées prend en charge au maximum 3 facteurs."

msgid "Bootstrap robust ANOVA is currently only supported for one-way designs."
msgstr "L'ANOVA robuste bootstrap n'est actuellement prise en charge que pour les plans à un facteur."

msgid "Robust ANOVA with medians supports at most 2 factors."
msgstr "L'ANOVA robuste avec médianes prend en charge au maximum 2 facteurs."

msgid "Robust ANOVA failed: %s"
msgstr "Échec de l'ANOVA robuste : %s"

msgid "Robust ANCOVA"
msgstr "ANCOVA robuste"

msgid "Covariate Value"
msgstr "Valeur de la covariable"

