msgstr "Varianz erklärt"

msgid "Effect"
msgstr "Effekt"

msgid "Critical Value"
msgstr "Kritischer Wert"

msgid "Heteroscedastic one-way ANOVA for trimmed means (%.0f%% trimming)."
msgstr ""
"Heteroskedastische einfaktorielle ANOVA für getrimmte Mittelwerte "
"(%.0f%%-Trimmen)."

msgid "\\u03BE denotes the explanatory measure of effect size."
msgstr "\\u03BE bezeichnet das erklärende Maß der Effektgröße."

msgid ""
"Percentile t-bootstrap one-way ANOVA for trimmed means (%.0f%% trimming, %d"
"bootstrap samples)."
msgstr ""
"Perzentil-t-Bootstrap-einfaktorielle ANOVA für getrimmte Mittelwerte "
"(%.0f%%-Trimmen, %d Bootstrap-Stichproben)."

msgid "Heteroscedastic one-way ANOVA for medians."
msgstr "Heteroskedastische einfaktorielle ANOVA für Mediane."

msgid "Two-way ANOVA for trimmed means (%.0f%% trimming)."
msgstr "Zweifaktorielle ANOVA für getrimmte Mittelwerte (%.0f%%-Trimmen)."

msgid "Two-way ANOVA for medians."
msgstr "Zweifaktorielle ANOVA für Mediane."

msgid "Three-way ANOVA for trimmed means (%.0f%% trimming)."
msgstr "Dreifaktorielle ANOVA für getrimmte Mittelwerte (%.0f%%-Trimmen)."

msgid "Post Hoc Tests"
msgstr "Post-hoc-Tests"

msgid "Post Hoc Comparisons - %s"
msgstr "Post-hoc-Vergleiche - %s"

msgid "Difference"
msgstr "Differenz"

msgid "%.0f%% CI"
msgstr "%.0f%% KI"

msgid "Could not compute post hoc comparisons for %s."
msgstr "Post-hoc-Vergleiche konnten für %s nicht berechnet werden."

msgid "Post hoc comparisons are not available for the medians method."
msgstr "Post-hoc-Vergleiche sind für die Median-Methode nicht verfügbar."

msgid "p<sub>Hochberg</sub>"
msgstr "p<sub>Hochberg</sub>"

msgid "p<sub>Bonf</sub>"
msgstr "p<sub>Bonf</sub>"

msgid "p<sub>Holm</sub>"
msgstr "p<sub>Holm</sub>"

