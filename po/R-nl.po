msgid "Bootstrap with trimmed means (%.0f%% trimming, %d bootstrap samples)."
msgstr "Bootstrap met getrimde gemiddelden (%.0f%% trimmen, %d bootstrapsteekproeven)."

msgid ""
"Reject H₀ if the test statistic exceeds the critical value %.3f (α = .05); no"
"p-value is reported by this bootstrap procedure."
msgstr ""
"Verwerp H₀ als de toetsingsgrootheid de kritieke waarde %.3f overschrijdt "
"(α = .05); deze bootstrapprocedure rapporteert geen p-waarde."

msgid "Trimmed means (%.0f%% trimming)."
msgstr "Getrimde gemiddelden (%.0f%% trimmen)."

msgid "Robust post hoc tests are only available for within-subjects factors."
msgstr "Robuuste post-hoc-toetsen zijn alleen beschikbaar voor binnen-proefpersoonfactoren."

msgid "Post hoc tests failed: %s"
msgstr "Post-hoc-toetsen zijn mislukt: %s"

