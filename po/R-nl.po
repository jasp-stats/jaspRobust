#, qt-format
msgid ""
"Robust ANCOVA requires a factor with exactly 2 levels, but '%1$s' has %2$d"
"levels."
msgstr ""
"Voor robuuste ANCOVA is een factor met precies 2 levels vereist, maar "
"'%1$s' heeft %2$d levels."

msgid "Robust ANCOVA failed: %s"
msgstr "Robuuste ANCOVA is mislukt: %s"

msgid "Robust ANOVA with trimmed means supports at most 3 factors."
msgstr "Robuuste ANOVA met getrimde gemiddelden ondersteunt maximaal 3 factoren."

msgid "Bootstrap robust ANOVA is currently only supported for one-way designs."
msgstr "Bootstrap-robuuste ANOVA wordt momenteel alleen ondersteund voor eenweg-ontwerpen."

msgid "Robust ANOVA with medians supports at most 2 factors."
msgstr "Robuuste ANOVA met medianen ondersteunt maximaal 2 factoren."

msgid "Robust ANOVA failed: %s"
msgstr "Robuuste ANOVA is mislukt: %s"

