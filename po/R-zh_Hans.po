msgstr "第 1 组：%1$s；第 2 组：%2$s"

msgid "Bootstrap ANCOVA with trimmed means (%.0f%% trimming, %d bootstrap samples)."
msgstr "使用修剪均值的 Bootstrap 协方差分析（%.0f%% 修剪，%d 个 Bootstrap 样本）。"

msgid "Trimmed means compared using %.0f%% trimming."
msgstr "使用 %.0f%% 修剪比较修剪均值。"

msgid "Wilcox, R. (2012). Introduction to Robust Estimation and Hypothesis Testing (3rd ed.). Elsevier."
msgstr ""
"Wilcox, R. (2012). Introduction to Robust Estimation and Hypothesis Testing "
"(3rd ed.). Elsevier."

